# =====================================================
# English Learning Platform - Environment Variables
# =====================================================
# Copia este archivo como .env y configura los valores

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/english_learning

# Optional: Debug mode (set to False in production)
DEBUG=False

# Optional: Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
